# GENERATED by cc-guides from .claude/fragments/.gitignore/ — do not edit; edit the fragments and push — CI renders.
# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
.env*

# Claude Code
.context/
.claude-scratch/
.scratch/
.claude/worktrees/
.claude/settings.local.json

# Python bytecode (guard hooks are Python even in non-Python repos)
__pycache__/
*.py[cod]

# Cargo build output — any target dir variant, anywhere (Rust cores appear in
# repos of every stack; a stray CARGO_TARGET_DIR must never reach the index)
target/
target-cargo/
.cargo-target/

# Go build output
/bin/
/dist/

# Test / coverage
*.test
*.out
coverage.txt

# go-task cache
.task/

# bootstrap verify binary smoke test
.go-smoke/

# Build output
/slop-cop

# Test + coverage
coverage.*

# Go
vendor/

# Env + local
*.local

# Editor
# base ships `.vscode/` (whole-dir); re-expose it so the extensions.json
# re-include below takes effect, then re-ignore the rest of the dir.
!.vscode/
.vscode/*
!.vscode/extensions.json
.idea
*.swo

# Cursor
.cursor/

# Agent memory dirs (Serena etc.)
.serena/

# Zig cross-compile cache: setup-zig points ZIG_*_CACHE_DIR here, so a restored
# cache lands in the worktree before goreleaser's dirty-tree check — ignore it.
.zig-cache/

# binrun wrapper: bin/ holds the committed dotslash symlink (bin/slop-cop) and
# the version-exact descriptor (bin/slop-cop.binrun). The plugin root is the
# repo root, so the Go `/bin/` ignore would otherwise hide them — re-expose the
# dir, re-ignore its contents, then re-include just the two tracked files (the
# `.vscode/` dance above).
!/bin/
/bin/*
!/bin/slop-cop
!/bin/slop-cop.binrun
